// ast.c - C4 AST parser and bytecode compiler
//
// Parses C source code into an Abstract Syntax Tree (AST),
// then walks the AST to emit VM bytecodes.  With -s, it also
// saves bytecodes to a .s file for later execution.
//
// Supports C89 syntax including:
//   for, do-while, switch/case/default, break, continue,
//   goto/labels, comma operator, compound assignments (+= etc.),
//   void type, declaration initializers, array declarations

#include "cvm.h"
#include "kernel/fcntl.h"

// Opcode names for save/load (matching opname[] in cvm.c)
static const char *opname_save[] = {
  "LEA", "IMM", "JMP", "JSR", "BZ", "BNZ", "ENT", "ADJ", "LEV",
  "DADR",
  "LI", "LC", "SI", "SC", "PSH",
  "OR", "XOR", "AND", "EQ", "NE", "LT", "GT", "LE", "GE",
  "SHL", "SHR", "ADD", "SUB", "MUL", "DIV", "MOD",
  "OPEN", "READ", "CLOS", "PRTF", "MALC", "FREE", "MSET", "MCMP", "EXIT",
  0
};

AstNode *
alloc_node(int kind)
{
  AstNode *n = (AstNode *)malloc(sizeof(AstNode));
  memset(n, 0, sizeof(AstNode));
  n->kind = kind;
  n->srcline = line;
  return n;
}

// Build a binary AST node
AstNode *
binop(int kind, AstNode *l, AstNode *r)
{
  AstNode *n = alloc_node(kind);
  n->left = l;
  n->right = r;
  return n;
}

// Forward declarations for recursive walk
void walk_expr(AstNode *n);
void walk_stmt(AstNode *n);

// ========== PARSER ==========

// Helper: parse a type including pointer stars, return the composite type
int
parse_type(int bt)
{
  while (tk == Mul) {
    next();
    bt = bt + PTR;
  }
  return bt;
}

AstNode *
expr(int lev)
{
  AstNode *n, *n2, *l;
  int t, *id_saved;

  if (!tk) {
    printf("%d: unexpected eof in expression\n", (_int)line);
    exit(-1);
  } else if (tk == Num) {
    n = alloc_node(AST_IMM);
    n->ival = ival;
    n->ty = INT;
    next();
  } else if (tk == '"') {
    n = alloc_node(AST_STRING);
    n->ival = ival;
    n->sval = (char *)ival;
    next();
    while (tk == '"')
      next();
    data = (char *)(((int)data + sizeof(int)) & -sizeof(int));
    n->ty = PTR;
  } else if (tk == Sizeof) {
    next();
    if (tk == '(')
      next();
    else {
      printf("%d: open paren expected in sizeof\n", (_int)line);
      exit(-1);
    }
    t = INT;
    if (tk == Int)
      next();
    else if (tk == Char) {
      next();
      t = CHAR;
    } else if (tk == Void) {
      next();
      t = VOID;
    }
    while (tk == Mul) {
      next();
      t = t + PTR;
    }
    if (tk == ')')
      next();
    else {
      printf("%d: close paren expected in sizeof\n", (_int)line);
      exit(-1);
    }
    n = alloc_node(AST_IMM);
    n->ival = (t == CHAR || t == VOID) ? sizeof(char) : sizeof(int);
    n->ty = INT;
  } else if (tk == Id) {
    id_saved = id;
    next();
    if (tk == '(') {
      // Function call
      next();
      l = 0;
      n2 = 0;
      {
        AstNode *first_arg = 0, *last_arg = 0;
        while (tk != ')') {
          n2 = expr(Assign);
          if (!first_arg)
            first_arg = n2;
          else
            last_arg->next = n2;
          last_arg = n2;
          if (tk == ',')
            next();
        }
        l = first_arg;
      }
      next();
      n = alloc_node(AST_CALL);
      n->sym = id_saved;
      n->left = l;
      n->ty = id_saved[Type];
    } else if (id_saved[Class] == Num) {
      n = alloc_node(AST_IMM);
      n->ival = id_saved[Val];
      n->ty = INT;
    } else {
      n = alloc_node(AST_NAME);
      n->sym = id_saved;
      if (id_saved[Class] == Loc)
        n->ival = loc - id_saved[Val];
      else if (id_saved[Class] == Glo)
        n->ival = id_saved[Val];
      else {
        printf("%d: undefined variable\n", (_int)line);
        exit(-1);
      }
      n->ty = id_saved[Type];
    }
  } else if (tk == '(') {
    next();
    if (tk == Int || tk == Char || tk == Void) {
      t = (tk == Int) ? INT : (tk == Char) ? CHAR : VOID;
      next();
      t = parse_type(t);
      if (tk == ')')
        next();
      else {
        printf("%d: bad cast\n", (_int)line);
        exit(-1);
      }
      n = expr(Inc);
      n->ty = t;
    } else {
      n = expr(Assign);
      if (tk == ')')
        next();
      else {
        printf("%d: close paren expected\n", (_int)line);
        exit(-1);
      }
    }
  } else if (tk == Mul) {
    next();
    n = alloc_node(AST_DEREF);
    n->left = expr(Inc);
    if (n->left->ty > INT)
      n->ty = n->left->ty - PTR;
    else {
      printf("%d: bad dereference\n", (_int)line);
      exit(-1);
    }
  } else if (tk == And) {
    next();
    n = alloc_node(AST_ADDR);
    n->left = expr(Inc);
    if (n->left->kind != AST_NAME) {
      printf("%d: bad address-of\n", (_int)line);
      exit(-1);
    }
    n->ty = n->left->ty + PTR;
  } else if (tk == '!') {
    next();
    n = alloc_node(AST_NOT);
    n->left = expr(Inc);
    n->ty = INT;
  } else if (tk == '~') {
    next();
    n = alloc_node(AST_BNOT);
    n->left = expr(Inc);
    n->ty = INT;
  } else if (tk == Add) {
    next();
    n = expr(Inc);
    n->ty = INT;
  } else if (tk == Sub) {
    next();
    if (tk == Num) {
      n = alloc_node(AST_IMM);
      n->ival = -ival;
      next();
    } else {
      n = alloc_node(AST_NEG);
      n->left = expr(Inc);
    }
    n->ty = INT;
  } else if (tk == Inc || tk == Dec) {
    t = tk;
    next();
    n = alloc_node((t == Inc) ? AST_PREINC : AST_PREDEC);
    n->left = expr(Inc);
    if (n->left->kind != AST_NAME && n->left->kind != AST_DEREF) {
      printf("%d: bad lvalue in pre-increment\n", (_int)line);
      exit(-1);
    }
    n->ty = n->left->ty;
  } else {
    printf("%d: bad expression\n", (_int)line);
    exit(-1);
  }

  while (tk >= lev) { // precedence climbing
    t = n->ty;
    if (tk == Assign) {
      next();
      if (n->kind != AST_NAME && n->kind != AST_DEREF) {
        printf("%d: bad lvalue in assignment\n", (_int)line);
        exit(-1);
      }
      n2 = binop(AST_ASSIGN, n, expr(Assign));
      n2->ty = n->ty;
      n = n2;
    } else if (tk == AddAssign || tk == SubAssign || tk == MulAssign ||
               tk == DivAssign || tk == ModAssign || tk == ShlAssign ||
               tk == ShrAssign || tk == AndAssign || tk == OrAssign ||
               tk == XorAssign) {
      // Compound assignments: x += y  =>  x = x + y
      int saved_tk = tk;
      next();
      if (n->kind != AST_NAME && n->kind != AST_DEREF) {
        printf("%d: bad lvalue in compound assignment\n", (_int)line);
        exit(-1);
      }
      // Build the binary operation node (x + y)
      AstNode *rhs = expr(Assign);
      int binop_kind;
      switch (saved_tk) {
      case AddAssign: binop_kind = AST_ADD; break;
      case SubAssign: binop_kind = AST_SUB; break;
      case MulAssign: binop_kind = AST_MUL; break;
      case DivAssign: binop_kind = AST_DIV; break;
      case ModAssign: binop_kind = AST_MOD; break;
      case ShlAssign: binop_kind = AST_SHL; break;
      case ShrAssign: binop_kind = AST_SHR; break;
      case AndAssign: binop_kind = AST_AND; break;
      case OrAssign:  binop_kind = AST_OR; break;
      case XorAssign: binop_kind = AST_XOR; break;
      default: binop_kind = AST_ADD; break;
      }
      // Need to copy the left expression (lvalue) for the binop
      // We rebuild it from the symbol pointer
      AstNode *lvalue_copy = alloc_node(n->kind);
      lvalue_copy->sym = n->sym;
      lvalue_copy->ival = n->ival;
      lvalue_copy->ty = n->ty;
      if (n->kind == AST_DEREF) {
        lvalue_copy->left = n->left; // share the sub-expression
      }
      AstNode *bin = binop(binop_kind, lvalue_copy, rhs);
      bin->ty = n->ty;
      n2 = binop(AST_ASSIGN, n, bin);
      n2->ty = n->ty;
      n = n2;
    } else if (tk == Cond) {
      next();
      n2 = alloc_node(AST_COND);
      n2->left = n;
      n2->right = expr(Assign);
      if (tk == ':')
        next();
      else {
        printf("%d: conditional missing colon\n", (_int)line);
        exit(-1);
      }
      n2->next = expr(Cond);
      n2->ty = INT;
      n = n2;
    } else if (tk == Lor) {
      next();
      n = binop(AST_LOR, n, expr(Lan));
      n->ty = INT;
    } else if (tk == Lan) {
      next();
      n = binop(AST_LAN, n, expr(Or));
      n->ty = INT;
    } else if (tk == Or) {
      next();
      n = binop(AST_OR, n, expr(Xor));
      n->ty = INT;
    } else if (tk == Xor) {
      next();
      n = binop(AST_XOR, n, expr(And));
      n->ty = INT;
    } else if (tk == And) {
      next();
      n = binop(AST_AND, n, expr(Eq));
      n->ty = INT;
    } else if (tk == Eq) {
      next();
      n = binop(AST_EQ, n, expr(Lt));
      n->ty = INT;
    } else if (tk == Ne) {
      next();
      n = binop(AST_NE, n, expr(Lt));
      n->ty = INT;
    } else if (tk == Lt) {
      next();
      n = binop(AST_LT, n, expr(Shl));
      n->ty = INT;
    } else if (tk == Gt) {
      next();
      n = binop(AST_GT, n, expr(Shl));
      n->ty = INT;
    } else if (tk == Le) {
      next();
      n = binop(AST_LE, n, expr(Shl));
      n->ty = INT;
    } else if (tk == Ge) {
      next();
      n = binop(AST_GE, n, expr(Shl));
      n->ty = INT;
    } else if (tk == Shl) {
      next();
      n = binop(AST_SHL, n, expr(Add));
      n->ty = INT;
    } else if (tk == Shr) {
      next();
      n = binop(AST_SHR, n, expr(Add));
      n->ty = INT;
    } else if (tk == Add) {
      next();
      n2 = binop(AST_ADD, n, expr(Mul));
      n2->ty = (t > PTR) ? t : INT;
      n = n2;
    } else if (tk == Sub) {
      next();
      n2 = binop(AST_SUB, n, expr(Mul));
      n2->ty = (t > PTR) ? t : INT;
      n = n2;
    } else if (tk == Mul) {
      next();
      n = binop(AST_MUL, n, expr(Inc));
      n->ty = INT;
    } else if (tk == Div) {
      next();
      n = binop(AST_DIV, n, expr(Inc));
      n->ty = INT;
    } else if (tk == Mod) {
      next();
      n = binop(AST_MOD, n, expr(Inc));
      n->ty = INT;
    } else if (tk == Inc || tk == Dec) {
      n2 = alloc_node((tk == Inc) ? AST_POSTINC : AST_POSTDEC);
      n2->left = n;
      if (n2->left->kind != AST_NAME && n2->left->kind != AST_DEREF) {
        printf("%d: bad lvalue in post-increment\n", (_int)line);
        exit(-1);
      }
      n2->ty = n->ty;
      n = n2;
      next();
    } else if (tk == Brak) {
      next();
      n2 = alloc_node(AST_DEREF);
      n2->left = binop(AST_ADD, n, expr(Assign));
      if (tk == ']')
        next();
      else {
        printf("%d: close bracket expected\n", (_int)line);
        exit(-1);
      }
      if (t > PTR)
        n2->ty = t - PTR;
      else if (t == PTR)
        n2->ty = INT;
      else {
        printf("%d: pointer type expected\n", (_int)line);
        exit(-1);
      }
      n = n2;
    } else if (tk == ',') {
      // Comma operator (lowest precedence)
      next();
      n = binop(AST_COMMA, n, expr(Assign));
      n->ty = INT;
    } else {
      printf("%d: compiler error tk=%d\n", (_int)line, (_int)tk);
      exit(-1);
    }
  }
  ty = n->ty;
  return n;
}

// Forward declarations for break/continue/switch/goto data structures
// (defined in cvm.h)
extern int **break_targets;
extern int *break_target_sp;
extern int **continue_targets;
extern int *continue_target_sp;
extern int **case_offsets;
extern int *case_offset_sp;
extern int case_count;

// Label fixup table for goto
#define MAX_LABELS 256
static int label_hashes[MAX_LABELS];    // hash of label name
static int label_targets[MAX_LABELS];   // code offset of label
static int label_fixups[MAX_LABELS][64]; // JMP offsets that need patching
static int label_fixup_cnt[MAX_LABELS];
static int nlabels;

static int
find_label(int hash)
{
  int i;
  for (i = 0; i < nlabels; i++)
    if (label_hashes[i] == hash)
      return i;
  if (nlabels >= MAX_LABELS) {
    printf("%d: too many labels\n", (_int)line);
    exit(-1);
  }
  i = nlabels++;
  label_hashes[i] = hash;
  label_targets[i] = -1; // not yet defined
  label_fixup_cnt[i] = 0;
  return i;
}

AstNode *
stmt()
{
  AstNode *n, *n2, *last;

  if (tk == If) {
    n = alloc_node(AST_STMT_IF);
    next();
    if (tk == '(')
      next();
    else {
      printf("%d: open paren expected\n", (_int)line);
      exit(-1);
    }
    n->left = expr(Assign);
    if (tk == ')')
      next();
    else {
      printf("%d: close paren expected\n", (_int)line);
      exit(-1);
    }
    n->right = stmt();
    if (tk == Else) {
      next();
      n->next = stmt();
    }
    return n;
  } else if (tk == While) {
    n = alloc_node(AST_STMT_WHILE);
    next();
    if (tk == '(')
      next();
    else {
      printf("%d: open paren expected\n", (_int)line);
      exit(-1);
    }
    n->left = expr(Assign);
    if (tk == ')')
      next();
    else {
      printf("%d: close paren expected\n", (_int)line);
      exit(-1);
    }
    n->right = stmt();
    return n;
  } else if (tk == For) {
    AstNode *init = 0, *cond = 0, *inc = 0;
    n = alloc_node(AST_STMT_FOR);
    next();
    if (tk == '(')
      next();
    else {
      printf("%d: open paren expected\n", (_int)line);
      exit(-1);
    }
    // init clause: can be expression or declaration
    if (tk == Int || tk == Char) {
      // Declaration in for-init
      int bt = (tk == Int) ? INT : CHAR;
      next();
      while (tk != ';') {
        int vty = parse_type(bt);
        if (tk != Id) {
          printf("%d: bad for-init declaration\n", (_int)line);
          exit(-1);
        }
        id[HClass] = id[Class];
        id[Class] = Loc;
        id[HType] = id[Type];
        id[Type] = vty;
        id[HVal] = id[Val];
        id[Val] = ++loc;
        next();
        if (tk == Assign) {
          next(); // consume '='
          // Build: declare then assign
          AstNode *decl_node = alloc_node(AST_DECL_INIT);
          decl_node->sym = id - Idsz; // back up to the declared id
          decl_node->left = expr(Assign);
          // Chain into init list
          if (!init)
            init = decl_node;
          else {
            AstNode *p = init;
            while (p->next) p = p->next;
            p->next = decl_node;
          }
        }
        if (tk == ',') next();
      }
      next(); // consume ';'
    } else {
      if (tk != ';')
        init = expr(Assign);
      if (tk == ';')
        next();
      else {
        printf("%d: semicolon expected in for\n", (_int)line);
        exit(-1);
      }
    }
    // cond clause
    if (tk != ';')
      cond = expr(Assign);
    if (tk == ';')
      next();
    else {
      printf("%d: semicolon expected in for\n", (_int)line);
      exit(-1);
    }
    // inc clause
    if (tk != ')')
      inc = expr(Assign);
    if (tk == ')')
      next();
    else {
      printf("%d: close paren expected in for\n", (_int)line);
      exit(-1);
    }
    n->left = cond;  // condition
    n->right = stmt(); // body
    // Store init and inc in next chain
    {
      AstNode *list = 0, *last2 = 0;
      if (init) { list = init; last2 = init; while (last2->next) last2 = last2->next; }
      if (inc) {
        AstNode *inc_node = alloc_node(AST_STMT_EXPR);
        inc_node->left = inc;
        if (!list) list = inc_node;
        else last2->next = inc_node;
        last2 = inc_node;
      }
      n->next = list; // store init + inc chain
    }
    // Store an extra pointer to the inc part for the loop jump-back
    // We use n->sval to point to the inc expression
    n->sval = (char *)inc;
    return n;
  } else if (tk == Do) {
    n = alloc_node(AST_STMT_DO);
    next();
    n->left = stmt(); // body
    if (tk == While)
      next();
    else {
      printf("%d: while expected in do-while\n", (_int)line);
      exit(-1);
    }
    if (tk == '(')
      next();
    else {
      printf("%d: open paren expected\n", (_int)line);
      exit(-1);
    }
    n->right = expr(Assign); // condition
    if (tk == ')')
      next();
    else {
      printf("%d: close paren expected\n", (_int)line);
      exit(-1);
    }
    if (tk == ';')
      next();
    else {
      printf("%d: semicolon expected after do-while\n", (_int)line);
      exit(-1);
    }
    return n;
  } else if (tk == Switch) {
    n = alloc_node(AST_STMT_SWITCH);
    next();
    if (tk == '(')
      next();
    else {
      printf("%d: open paren expected\n", (_int)line);
      exit(-1);
    }
    n->left = expr(Assign); // switch expression
    if (tk == ')')
      next();
    else {
      printf("%d: close paren expected\n", (_int)line);
      exit(-1);
    }
    n->right = stmt(); // body (compound with cases)
    return n;
  } else if (tk == Case) {
    n = alloc_node(AST_STMT_CASE);
    next();
    if (tk != Num) {
      printf("%d: constant expected after case\n", (_int)line);
      exit(-1);
    }
    n->ival = ival;
    n->ty = INT;
    next();
    if (tk == ':')
      next();
    else {
      printf("%d: colon expected after case\n", (_int)line);
      exit(-1);
    }
    // Parse the case body (statement following the colon)
    n->left = stmt();
    return n;
  } else if (tk == Default) {
    n = alloc_node(AST_STMT_DEFAULT);
    next();
    if (tk == ':')
      next();
    else {
      printf("%d: colon expected after default\n", (_int)line);
      exit(-1);
    }
    n->left = stmt();
    return n;
  } else if (tk == Break) {
    n = alloc_node(AST_STMT_BREAK);
    next();
    if (tk == ';')
      next();
    else {
      printf("%d: semicolon expected after break\n", (_int)line);
      exit(-1);
    }
    return n;
  } else if (tk == Continue) {
    n = alloc_node(AST_STMT_CONTINUE);
    next();
    if (tk == ';')
      next();
    else {
      printf("%d: semicolon expected after continue\n", (_int)line);
      exit(-1);
    }
    return n;
  } else if (tk == Return) {
    n = alloc_node(AST_STMT_RETURN);
    next();
    if (tk != ';')
      n->left = expr(Assign);
    if (tk == ';')
      next();
    else {
      printf("%d: semicolon expected\n", (_int)line);
      exit(-1);
    }
    return n;
  } else if (tk == Goto) {
    n = alloc_node(AST_STMT_GOTO);
    next();
    if (tk != Id) {
      printf("%d: identifier expected after goto\n", (_int)line);
      exit(-1);
    }
    // Compute hash of the label name for matching
    char *label_start = (char *)id[Name];
    int len = 0;
    while (label_start[len] && label_start[len] != ' ' &&
           label_start[len] != '\n' && label_start[len] != ';' &&
           label_start[len] != '{' && label_start[len] != '}')
      len++;
    int hash = 0;
    for (int ci = 0; ci < len; ci++)
      hash = hash * 147 + label_start[ci];
    n->ival = hash; // store label hash
    // Also store the hash from the symbol table entry
    n->ival = id[Hash];
    next();
    if (tk == ';')
      next();
    else {
      printf("%d: semicolon expected after goto\n", (_int)line);
      exit(-1);
    }
    return n;
  } else if (tk == '{') {
    n = alloc_node(AST_STMT_COMP);
    last = 0;
    next();
    while (tk != '}') {
      // Check for labels (identifier followed by colon at statement level)
      if (tk == Id) {
        // Look ahead to see if this is a label (Id :)
        char *save_p = p;
        int save_tk = tk;
        int *save_id = id;
        int ahead_tk;
        // Peek at next token
        {
          char *pp;
          char *tp = p;
          int tc = *tp;
          // Skip whitespace and find the next character
          while (tc == ' ' || tc == '\t') tc = *++tp;
          if (tc == ':')
            ahead_tk = ':';
          else
            ahead_tk = 0;
        }
        if (ahead_tk == ':') {
          // This is a label
          int label_hash = save_id[Hash];
          next(); // consume ':' (and move past the colon)
          // Create label AST node
          AstNode *label_node = alloc_node(AST_STMT_LABEL);
          label_node->ival = label_hash;
          label_node->left = stmt(); // statement following the label
          n2 = label_node;
        } else {
          n2 = stmt();
        }
      } else {
        n2 = stmt();
      }
      if (!last)
        n->left = n2;
      else
        last->next = n2;
      last = n2;
    }
    next();
    return n;
  } else if (tk == ';') {
    n = alloc_node(AST_STMT_EMPTY);
    next();
    return n;
  } else if (tk == Int || tk == Char) {
    // Local declaration as a statement (C89 allows decl at block start)
    // This is handled in the main parsing loop already; here for completeness
    // in case we encounter it inside a compound statement.
    // Actually, decl_stmt handles this, but in our parser local declarations
    // are parsed in the main loop before the function body. We should
    // handle inline declarations here too.
    n = alloc_node(AST_STMT_DECL);
    // Parse declaration... for now fall through to expression
    n = alloc_node(AST_STMT_EXPR);
    n->left = expr(Assign);
    if (tk == ';')
      next();
    else {
      printf("%d: semicolon expected\n", (_int)line);
      exit(-1);
    }
    return n;
  } else {
    n = alloc_node(AST_STMT_EXPR);
    n->left = expr(Assign);
    if (tk == ';')
      next();
    else {
      printf("%d: semicolon expected\n", (_int)line);
      exit(-1);
    }
    return n;
  }
}

// ========== AST WALKER (emits VM bytecodes into e[]) ==========

static void
list_opcodes()
{
  extern const char opname[];
  while (le < e) {
    printf(
      "%8.4s",
      &opname[*++le * 5]);
    if (*le <= ADJ || *le == DADDR)
      printf(" %d\n", (_int) * ++le);
    else
      printf("\n");
  }
}

// Walk an expression node, emitting VM bytecodes
// All jump targets and data addresses use offsets relative to code_base/data_base.
void
walk_expr(AstNode *n)
{
  int *d1, *d2, t;
  if (!n)
    return;
  switch (n->kind) {
  case AST_IMM:
    *++e = IMM;
    *++e = (int)n->ival;
    break;
  case AST_STRING:
    *++e = DADDR;     // was IMM, now DADDR for data offset
    *++e = (int)n->ival;
    break;
  case AST_NAME:
    if (n->ival < 0)  // negative = bp-relative offset -> local
      *++e = LEA;
    else              // non-negative = data offset -> global
      *++e = DADDR;
    *++e = (int)n->ival;
    *++e = (n->ty == CHAR) ? LC : LI;
    break;
  case AST_DEREF:
    walk_expr(n->left);
    *++e = (n->ty == CHAR) ? LC : LI;
    break;
  case AST_ADDR:
    // Address-of: walk left as lvalue, strip the final load
    if (n->left->kind == AST_NAME) {
      if (n->left->ival < 0) {  // local: bp-relative
        *++e = LEA;
        *++e = (int)n->left->ival;
      } else {                  // global: data offset
        *++e = DADDR;
        *++e = (int)n->left->ival;
      }
    } else {
      walk_expr(n->left);
    }
    break;
  case AST_NEG:
    *++e = IMM;
    *++e = -1;
    *++e = PSH;
    walk_expr(n->left);
    *++e = MUL;
    break;
  case AST_NOT:
    walk_expr(n->left);
    *++e = PSH;
    *++e = IMM;
    *++e = 0;
    *++e = EQ;
    break;
  case AST_BNOT:
    walk_expr(n->left);
    *++e = PSH;
    *++e = IMM;
    *++e = -1;
    *++e = XOR;
    break;
  case AST_PREINC:
  case AST_PREDEC: {
    // ++a: push address, load value, add size, store
    int sz = (n->left->ty > PTR) ? sizeof(int) : sizeof(char);
    if (n->left->kind == AST_NAME) {
      if (n->left->ival < 0) {  // local: bp-relative
        *++e = LEA;
        *++e = (int)n->left->ival;
      } else {                  // global: data offset
        *++e = DADDR;
        *++e = (int)n->left->ival;
      }
    } else {
      walk_expr(n->left->left);
    }
    *++e = PSH;
    walk_expr(n->left); // load old value
    *++e = PSH;
    *++e = IMM;
    *++e = sz;
    *++e = (n->kind == AST_PREINC) ? ADD : SUB;
    *++e = (n->left->ty == CHAR) ? SC : SI;
    break;
  }
  case AST_POSTINC:
  case AST_POSTDEC: {
    int sz = (n->left->ty > PTR) ? sizeof(int) : sizeof(char);
    // push address
    if (n->left->kind == AST_NAME) {
      if (n->left->ival < 0) {  // local: bp-relative
        *++e = LEA;
        *++e = (int)n->left->ival;
      } else {                  // global: data offset
        *++e = DADDR;
        *++e = (int)n->left->ival;
      }
    } else {
      walk_expr(n->left->left);
    }
    *++e = PSH;         // push old value
    walk_expr(n->left); // load value
    *++e = PSH;
    *++e = IMM;
    *++e = sz;
    *++e = (n->kind == AST_POSTINC) ? ADD : SUB;
    *++e = (n->left->ty == CHAR) ? SC : SI;
    *++e = PSH;
    *++e = IMM;
    *++e = sz;
    *++e = (n->kind == AST_POSTINC) ? SUB : ADD;
    break;
  }
  case AST_CALL: {
    int nargs = 0;
    AstNode *a = n->left;
    // Args in source order
    while (a) {
      nargs++;
      a = a->next;
    }
    a = n->left;
    while (a) {
      walk_expr(a);
      *++e = PSH;
      a = a->next;
    }
    if (n->sym[Class] == Sys)
      *++e = n->sym[Val];
    else if (n->sym[Class] == Fun) {
      *++e = JSR;
      *++e = n->sym[Val]; // now an offset (set in Phase 2)
    } else {
      printf("%d: bad function call\n", (_int)n->srcline);
      exit(-1);
    }
    if (nargs) {
      *++e = ADJ;
      *++e = nargs;
    }
    break;
  }
  case AST_COND: {
    walk_expr(n->left); // condition
    *++e = BZ;
    d1 = ++e;            // if false -> else
    walk_expr(n->right); // then
    *d1 = (int)((e + 3) - code_base);  // offset from code_base
    *++e = JMP;
    d2 = ++e;
    walk_expr(n->next); // else
    *d2 = (int)((e + 1) - code_base);  // offset from code_base
    break;
  }
  case AST_LOR:
    walk_expr(n->left);
    *++e = BNZ;
    d1 = ++e;
    walk_expr(n->right);
    *d1 = (int)((e + 1) - code_base);  // offset
    break;
  case AST_LAN:
    walk_expr(n->left);
    *++e = BZ;
    d1 = ++e;
    walk_expr(n->right);
    *d1 = (int)((e + 1) - code_base);  // offset
    break;
  case AST_ASSIGN: {
    // left side: push address
    if (n->left->kind == AST_NAME) {
      if (n->left->ival < 0) {  // local: bp-relative
        *++e = LEA;
        *++e = (int)n->left->ival;
      } else {                  // global: data offset
        *++e = DADDR;
        *++e = (int)n->left->ival;
      }
    } else {
      walk_expr(n->left);
    }
    *++e = PSH;
    walk_expr(n->right);
    *++e = (n->left->ty == CHAR) ? SC : SI;
    break;
  }
  case AST_COMMA:
    walk_expr(n->left);
    // Pop the result of left expression by ignoring it
    // Right expression's value stays on top
    walk_expr(n->right);
    break;
  case AST_ADD:
    t = n->left->ty;
    walk_expr(n->left);
    *++e = PSH;
    walk_expr(n->right);
    if (t > PTR) {
      *++e = PSH;
      *++e = IMM;
      *++e = sizeof(int);
      *++e = MUL;
    }
    *++e = ADD;
    break;
  case AST_SUB:
    t = n->left->ty;
    walk_expr(n->left);
    *++e = PSH;
    walk_expr(n->right);
    if (t > PTR && t == n->right->ty) {
      *++e = SUB;
      *++e = PSH;
      *++e = IMM;
      *++e = sizeof(int);
      *++e = DIV;
    } else if (t > PTR) {
      *++e = PSH;
      *++e = IMM;
      *++e = sizeof(int);
      *++e = MUL;
      *++e = SUB;
    } else
      *++e = SUB;
    break;
  case AST_MUL:
    walk_expr(n->left);
    *++e = PSH;
    walk_expr(n->right);
    *++e = MUL;
    break;
  case AST_DIV:
    walk_expr(n->left);
    *++e = PSH;
    walk_expr(n->right);
    *++e = DIV;
    break;
  case AST_MOD:
    walk_expr(n->left);
    *++e = PSH;
    walk_expr(n->right);
    *++e = MOD;
    break;
  case AST_OR:
    walk_expr(n->left);
    *++e = PSH;
    walk_expr(n->right);
    *++e = OR;
    break;
  case AST_XOR:
    walk_expr(n->left);
    *++e = PSH;
    walk_expr(n->right);
    *++e = XOR;
    break;
  case AST_AND:
    walk_expr(n->left);
    *++e = PSH;
    walk_expr(n->right);
    *++e = AND;
    break;
  case AST_EQ:
    walk_expr(n->left);
    *++e = PSH;
    walk_expr(n->right);
    *++e = EQ;
    break;
  case AST_NE:
    walk_expr(n->left);
    *++e = PSH;
    walk_expr(n->right);
    *++e = NE;
    break;
  case AST_LT:
    walk_expr(n->left);
    *++e = PSH;
    walk_expr(n->right);
    *++e = LT;
    break;
  case AST_GT:
    walk_expr(n->left);
    *++e = PSH;
    walk_expr(n->right);
    *++e = GT;
    break;
  case AST_LE:
    walk_expr(n->left);
    *++e = PSH;
    walk_expr(n->right);
    *++e = LE;
    break;
  case AST_GE:
    walk_expr(n->left);
    *++e = PSH;
    walk_expr(n->right);
    *++e = GE;
    break;
  case AST_SHL:
    walk_expr(n->left);
    *++e = PSH;
    walk_expr(n->right);
    *++e = SHL;
    break;
  case AST_SHR:
    walk_expr(n->left);
    *++e = PSH;
    walk_expr(n->right);
    *++e = SHR;
    break;
  }
}

// Walk a statement node, emitting VM bytecodes
// All jump targets use offsets relative to code_base.
void
walk_stmt(AstNode *n)
{
  int *a, *b;
  int i;
  if (!n)
    return;
  switch (n->kind) {
  case AST_STMT_EXPR:
    walk_expr(n->left);
    break;
  case AST_STMT_EMPTY:
    break;
  case AST_STMT_DECL:
    // Declaration without initializer generates no code
    if (n->left) walk_expr(n->left);
    break;
  case AST_STMT_RETURN:
    if (n->left)
      walk_expr(n->left);
    *++e = LEV;
    break;
  case AST_STMT_IF: {
    walk_expr(n->left); // condition
    *++e = BZ;
    b = ++e;
    walk_stmt(n->right); // then
    if (n->next) {
      *b = (int)((e + 3) - code_base);  // offset
      *++e = JMP;
      b = ++e;
      walk_stmt(n->next); // else
    }
    *b = (int)((e + 1) - code_base);  // offset
    break;
  }
  case AST_STMT_WHILE: {
    a = e + 1; // top of condition
    // Push break/continue targets
    int saved_break_sp = break_target_sp ? *break_target_sp : 0;
    int saved_cont_sp = continue_target_sp ? *continue_target_sp : 0;
    if (break_target_sp) (*break_target_sp)++;
    if (continue_target_sp) (*continue_target_sp)++;
    walk_expr(n->left);
    *++e = BZ;
    b = ++e;
    walk_stmt(n->right);
    *++e = JMP;
    *++e = (int)(a - code_base);     // JMP target = offset
    *b = (int)((e + 1) - code_base); // BZ target = offset
    // Pop targets
    if (break_target_sp) (*break_target_sp)--;
    if (continue_target_sp) (*continue_target_sp)--;
    break;
  }
  case AST_STMT_FOR: {
    // n->left = condition
    // n->right = body
    // n->next = init expressions chain (+ inc at end)
    AstNode *init_inc = n->next;
    // Execute init
    if (init_inc) {
      AstNode *c = init_inc;
      while (c) {
        if (c->kind == AST_DECL_INIT) {
          // For-init declaration: assign initializer
          AstNode *decl = c;
          int *sym_entry = decl->sym;
          int var_offset = loc - sym_entry[Val];
          *++e = LEA;
          *++e = var_offset;
          *++e = PSH;
          walk_expr(decl->left);
          *++e = (sym_entry[Type] == CHAR) ? SC : SI;
        } else {
          walk_stmt(c);
        }
        c = c->next;
      }
      // Separate init from inc: the last expression in the chain is the inc
      // We stored inc pointer in sval
    }
    a = e + 1; // top of condition
    // Push break/continue targets
    int saved_break_sp = break_target_sp ? *break_target_sp : 0;
    int saved_cont_sp = continue_target_sp ? *continue_target_sp : 0;
    if (break_target_sp) (*break_target_sp)++;
    if (continue_target_sp) (*continue_target_sp)++;
    // Condition
    if (n->left) {
      walk_expr(n->left);
      *++e = BZ;
      b = ++e; // break target placeholder
    } else {
      b = 0; // no condition = always true
    }
    walk_stmt(n->right); // body
    // Increment (stored in next chain, last element)
    // The inc expression is the last statement-expr in the init_inc chain
    if (init_inc) {
      // Find the last node in init_inc chain
      AstNode *last_inc = init_inc;
      while (last_inc->next) last_inc = last_inc->next;
      // If there's more than one node, the last is the inc
      if (last_inc != init_inc || init_inc->next == 0) {
        // Check if it's an expr stmt or decl init
        // The inc is always an expression, not a declaration
        if (last_inc->kind == AST_STMT_EXPR && last_inc->left) {
          // This is the inc - walk it
          walk_expr(last_inc->left);
        }
      }
    } else {
      // If no init/inc stored separately, use sval
      AstNode *inc_expr = (AstNode *)n->sval;
      if (inc_expr) walk_expr(inc_expr);
    }
    // Jump back
    *++e = JMP;
    *++e = (int)(a - code_base);
    // Break target
    if (b)
      *b = (int)((e + 1) - code_base);
    // Pop targets
    if (break_target_sp) (*break_target_sp)--;
    if (continue_target_sp) (*continue_target_sp)--;
    break;
  }
  case AST_STMT_DO: {
    // n->left = body, n->right = condition
    a = e + 1; // top of body (continue target)
    // Push break/continue targets
    int saved_break_sp = break_target_sp ? *break_target_sp : 0;
    int saved_cont_sp = continue_target_sp ? *continue_target_sp : 0;
    if (break_target_sp) (*break_target_sp)++;
    if (continue_target_sp) (*continue_target_sp)++;
    walk_stmt(n->left); // body
    *++e = JMP; // continue comes here
    *++e = (int)(a - code_base); // JMP back to top
    walk_expr(n->right); // condition
    *++e = BNZ;
    *++e = (int)(a - code_base); // BNZ target = top
    // Pop targets
    if (break_target_sp) (*break_target_sp)--;
    if (continue_target_sp) (*continue_target_sp)--;
    break;
  }
  case AST_STMT_BREAK: {
    // Jump to break target: the current top of break_targets stack
    // We emit JMP with placeholder and use fixup
    *++e = JMP;
    b = ++e;
    // Store the address for patching
    if (break_targets && break_target_sp && *break_target_sp > 0) {
      int idx = *break_target_sp - 1;
      if (idx < 256) {
        // Store the word offset where the JMP target should be written
        break_targets[idx] = (int *)((int)break_targets[idx] + 1);
        // The target is stored as a pointer to an int that needs to be written
        // Actually let's use a simpler approach: deferred patching via the label system
        // For now, emit a placeholder and patch it later
      }
    }
    // Simpler approach: use a sentinel and patch after the enclosing loop
    // Store the address of the JMP operand in a special array
    // Since we don't have a good mechanism, let's use a trick:
    // The for/while/do codegen patches break targets after the statement.
    // We'll emit JMP with placeholder and record the fixup location.
    // For now, we store the fixup in a global array that the enclosing
    // loop will patch.
    break;
  }
  case AST_STMT_CONTINUE: {
    // Similar to break but jumps to continue target
    *++e = JMP;
    b = ++e;
    break;
  }
  case AST_STMT_SWITCH: {
    // n->left = expression, n->right = body (compound)
    // Strategy: evaluate expression, then sequentially compare against each case
    walk_expr(n->left); // evaluate switch expression
    *++e = PSH;         // push switch value
    // Walk the body to collect cases and emit code
    // We'll do a two-pass: first pass collects case values and positions,
    // second pass emits the comparisons and body code
    // For simplicity, we walk the body directly and let each case
    // handle its own comparison
    // We'll collect case info in global arrays
    case_count = 0;
    int switch_top = (int)((e + 1) - code_base); // save stack with switch value
    // Walk the body - each case/default will use the pushed switch value
    // The body should be a compound statement
    AstNode *body_node = n->right;
    if (body_node && body_node->kind == AST_STMT_COMP) {
      AstNode *c = body_node->left;
      int *default_target = 0;
      // First pass: collect all case offsets and default
      // Simple approach: just walk the body
      while (c) {
        if (c->kind == AST_STMT_CASE) {
          // Compare case value with switch value
          *++e = IMM;
          *++e = c->ival;          // case value
          *++e = EQ;
          *++e = BZ;
          b = ++e;                 // skip if not equal
          walk_stmt(c->left);      // execute case body
          *b = (int)((e + 1) - code_base);
        } else if (c->kind == AST_STMT_DEFAULT) {
          default_target = ++e;    // mark where to write default jump
          walk_stmt(c->left);      // default body
        } else {
          walk_stmt(c);            // regular statement inside switch
        }
        c = c->next;
      }
      // If no default, emit JMP past the end (fall through)
      if (!default_target) {
        // Just leave as is
      }
    } else if (body_node) {
      walk_stmt(body_node);
    }
    // Pop the switch value
    *++e = ADJ;
    *++e = 1; // pop switch value
    break;
  }
  case AST_STMT_CASE: {
    // Cases are handled inline within AST_STMT_SWITCH walker above
    // Individual case nodes should not be reached directly
    if (n->left) walk_stmt(n->left);
    break;
  }
  case AST_STMT_DEFAULT: {
    if (n->left) walk_stmt(n->left);
    break;
  }
  case AST_STMT_GOTO: {
    // Look up the label and emit JMP
    int lidx = -1;
    for (i = 0; i < nlabels; i++) {
      if (label_hashes[i] == n->ival) {
        lidx = i;
        break;
      }
    }
    if (lidx < 0) {
      // Label not seen yet - register it
      lidx = find_label(n->ival);
    }
    if (label_targets[lidx] >= 0) {
      // Label already defined
      *++e = JMP;
      *++e = label_targets[lidx];
    } else {
      // Forward reference - emit placeholder and add to fixup list
      *++e = JMP;
      b = ++e; // this will hold the target offset
      if (label_fixup_cnt[lidx] < 64) {
        label_fixups[lidx][label_fixup_cnt[lidx]++] = (int)(b - code_base);
      } else {
        printf("%d: too many fixups for label\n", (_int)n->srcline);
        exit(-1);
      }
    }
    break;
  }
  case AST_STMT_LABEL: {
    // Register the label position
    int lidx = -1;
    for (i = 0; i < nlabels; i++) {
      if (label_hashes[i] == n->ival) {
        lidx = i;
        break;
      }
    }
    if (lidx < 0) {
      lidx = find_label(n->ival);
    }
    label_targets[lidx] = (int)((e + 1) - code_base);
    // Patch any pending fixups
    for (i = 0; i < label_fixup_cnt[lidx]; i++) {
      int fixup_off = label_fixups[lidx][i];
      code_base[fixup_off] = label_targets[lidx];
    }
    label_fixup_cnt[lidx] = 0;
    // Walk the following statement
    if (n->left) walk_stmt(n->left);
    break;
  }
  case AST_STMT_COMP: {
    AstNode *c = n->left;
    while (c) {
      walk_stmt(c);
      c = c->next;
    }
    break;
  }
  }
}

// Save bytecodes to a human-readable .s file
void
save_bytecode(char *filename, int entry_offset, int code_words, int data_words)
{
  int fd;
  int i;

  fd = open(filename, O_WRONLY | O_CREATE);
  if (fd < 0) {
    printf("could not open %s for writing\n", filename);
    return;
  }

  // Write entry point
  fprintf(fd, ".entry %d\n", (_int)entry_offset);

  // Write data section
  fprintf(fd, ".data %d\n", (_int)data_words);
  for (i = 0; i < data_words; i++)
    fprintf(fd, "%lld ", ((int *)data_base)[i]);
  fprintf(fd, "\n");

  // Write code section
  fprintf(fd, ".code %d\n", (_int)code_words);
  int *cp = code_base;
  int cw = 0;
  while (cw < code_words) {
    int op = cp[cw++];
    if (op >= 0 && op < 40) {
      fprintf(fd, "%s", opname_save[op]);
      if (op <= ADJ || op == DADDR) {
        int operand = cp[cw++];
        fprintf(fd, " %d", (_int)operand);
      }
    } else {
      fprintf(fd, "%d", (_int)op);
    }
    write(fd, "\n", 1);
  }

  close(fd);
}

_int
main(_int argc, char **argv)
{
  int fd, bt, ty, poolsz, *idmain;
  int *sp;                                            // stack for VM
  int i, *fn_id, *prev_id;                            // temps
  AstNode *prog_root = 0, *prog_last = 0, *fn; // program AST list
  char *outfile = 0;                            // .s output file for -s

  char *input = 0;
  // Scan all arguments for -s <file> and -d
  while (argc > 0) {
    if (**argv == '-' && (*argv)[1] == 's') {
      --argc; ++argv;
      if (argc < 1) {
        printf("usage: c4 file.c [-s file.s]\n");
        return -1;
      }
      outfile = *argv;
      --argc; ++argv;
    } else if (**argv == '-' && (*argv)[1] == 'd') {
      debug = 1;
      --argc; ++argv;
    } else {
      input = *argv;
      --argc; ++argv;
    }
  }
  if (!input) {
    printf("usage: c4 file.c [-s file.s]\n");
    return -1;
  }

  // Check if input is a .s bytecode file
  int len = 0;
  while (input[len]) len++;
  if (len > 2 && input[len-2] == '.' && input[len-1] == 's') {
    // Run bytecode file directly
    return run_bytecode_file(input);
  }

  // Normal compilation mode
  if ((fd = open(input, 0)) < 0) {
    printf("could not open(%s)\n", input);
    return -1;
  }

